# Dry-run mode: when set to '1', every driver logs what it *would* send
# ("DRY RUN, would send...") instead of sending real network traffic, and
# index.js skips starting the SQS Listener and the Insteon Listener.
# Useful for testing routing logic without actuating physical devices.
# APOLLO_DRY_RUN=1

# MQTT broker (Mosquitto). Apollo connects at startup regardless of dry-run --
# MQTT publishes stay active in dry-run so routing logic is observable via
# mosquitto_sub without touching hardware. Defaults to localhost if unset.
MQTT_BROKER_URL=mqtt://localhost:1883

# For SQS queue
AWSregion=us-east-1
AWSaccessKeyId=XXXXXXXXXXXXXXXX
AWSsecretAccessKey=XXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWSQueueURL=https://sqs.us-east-1.amazonaws.com/XXXXXXXXXXXXXX/apollo

# Insteon Hub
# NOTE: This is not the username you use to log into the Insteon app. 
# This is the user & pass you get from the underside of the Insteon Hub.
# See documentation
INSTEON_HUB_IP=111.111.1.1
INSTEON_USERNAME=XXXXXXXXX
INSTEON_PASSWORD=XXXXXXXXXX

# Philips Hue Bridge
# NOTE: This is not the username you use to log into the Hue app. 
# This is the username you get from the Hue Bridge.
# See documentation
PHILIPS_HUE_IP=111.111.1.1
PHILIPS_HUE_USERNAME=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Apollo DMX Bridge
DMX_BRIDGE_IP=111.111.1.1

# Spotify Credentials
spotifyClientId=XXXXXXXXXXXXXXXX
spotifyClientSecret=XXXXXXXXXXXXXXXX
spotifyRedirectUri=https://www.google.com
spotifyRefreshToken=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Spotify now-playing MQTT publisher (Stage 9, issue #22): when set to '1',
# polls getMyCurrentPlaybackState() every 10s and publishes retained
# apollo/home/spotify/player/state. Opt-in -- it costs a Spotify API call
# every 10s around the clock, and nothing consumes the data until Stage 11
# adds a now-playing card to the dashboard. Ignored when APOLLO_DRY_RUN=1.
# SPOTIFY_NOW_PLAYING=1

# Find My iPhone
icloudUsername=XXXXXXXXXXXXXXXX
icloudPassword=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
icloudDeviceID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
