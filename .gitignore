# Logs
logs
*.log

# Dependency directories
node_modules/
web/node_modules/

# Dashboard v2 build output (rsynced to the Pi, not tracked)
public/app/

# Optional npm cache directory
.npm

# Environment variables (secrets)
.env

node_modules

# Personal config — kept in apollo_home_control-private (separate private repo)
# Symlinked into config/ at runtime; not tracked in this repo.
config/devices.json
config/lights.json
config/triggers.json
config/deviceScenes.json
config/insteonKeypad.json
config/lightingScenes.json
config/macros.json

# Folder for notes not for sharing
private

# Old versions
_OLD
_OLD/*

# OS Files
.DS_Store
.vscode/*

# Claude Code session log — private by default (verbatim prompts)
/session-log/

# Runtime-written dashboard user prefs (e.g. custom swatch palette) —
# not hand-edited config, lives on the Pi across deploys (see
# private/update-pi.sh's EXCLUDE_PATTERNS)
/data/
